---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;

const asciiHeader = `
 ╔══════════════════════════════════════════════════════════╗
 ║  ███╗   ███╗ █████╗ ████████╗██████╗ ██╗██╗  ██╗      ║
 ║  ████╗ ████║██╔══██╗╚══██╔══╝██╔══██╗██║╚██╗██╔╝      ║
 ║  ██╔████╔██║███████║   ██║   ██████╔╝██║ ╚███╔╝       ║
 ║  ██║╚██╔╝██║██╔══██║   ██║   ██╔══██╗██║ ██╔██╗       ║
 ║  ██║ ╚═╝ ██║██║  ██║   ██║   ██║  ██║██║██╔╝ ██╗      ║
 ║  ╚═╝     ╚═╝╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝╚═╝╚═╝  ╚═╝      ║
 ╚══════════════════════════════════════════════════════════╝`;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: auto;
				padding: 1em;
			}

			.post-header {
				margin-bottom: 2em;
				text-align: center;
			}

			.post-title {
				font-size: 1.8em;
				margin: 1em 0 0.5em 0;
				text-shadow: 0 0 12px var(--green-glow);
			}

			.post-meta {
				color: var(--green-dim);
				font-size: 0.9em;
				margin-bottom: 1em;
			}

			.prose {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				padding: 2em;
				background: rgba(0, 255, 65, 0.02);
			}

			.prose :global(h2) {
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				padding-bottom: 0.3em;
				margin-top: 2em;
			}

			.prose :global(img) {
				display: none;
			}

			.post-footer {
				margin-top: 2em;
				padding-top: 1em;
				border-top: 1px solid rgba(0, 255, 65, 0.2);
				color: var(--green-dim);
				font-size: 0.85em;
			}

			.back-link {
				display: inline-block;
				margin-top: 1.5em;
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				text-decoration: none;
				color: var(--green);
			}

			.back-link:hover {
				background: rgba(0, 255, 65, 0.1);
				border-color: var(--green);
			}

			@media (max-width: 600px) {
				.prose {
					padding: 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="post-header">
					<pre class="ascii-art">{asciiHeader}</pre>
					<h1 class="post-title">{title}</h1>
					<div class="post-meta">
						<span class="prompt">date:</span> <FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated"> | <span class="prompt">updated:</span> <FormattedDate date={updatedDate} /></span>
						)}
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
				<div class="post-footer">
					<span class="prompt">EOF</span>
				</div>
				<a href="/blog" class="back-link">← cd ../blog</a>
			</article>
		</main>
		<Footer />
	</body>
</html>
