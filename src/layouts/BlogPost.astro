---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 900px;
				margin: auto;
				padding: 0 1.5em;
			}

			/* Navigation */
			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				margin-bottom: 2em;
			}

			.site-name {
				font-size: 1.1em;
				font-weight: bold;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
			}

			.site-name::before {
				content: '> ';
				color: var(--green-dim);
			}

			.top-nav {
				display: flex;
				gap: 0.5em;
			}

			.top-nav a {
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				text-decoration: none;
				color: var(--green-dim);
				font-size: 0.9em;
				transition: all 0.2s;
			}

			.top-nav a:hover,
			.top-nav a.active {
				color: var(--green);
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			.post-article {
				padding: 3em 0;
			}

			.post-header {
				text-align: center;
				margin-bottom: 3em;
				padding-bottom: 2em;
				border-bottom: 1px solid rgba(0, 255, 65, 0.1);
			}

			.post-header .ascii-art {
				margin-bottom: 1.5em;
			}

			.post-title {
				font-size: 2em;
				margin: 1em 0 0.5em 0;
				text-shadow: 0 0 12px var(--green-glow);
				color: var(--green);
				line-height: 1.3;
			}

			.post-meta {
				color: var(--green-dim);
				font-size: 0.9em;
				margin-bottom: 1em;
			}

			.post-meta .separator {
				margin: 0 0.5em;
				color: rgba(0, 255, 65, 0.3);
			}

			.prose {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				padding: 2.5em;
				background: rgba(0, 255, 65, 0.02);
				line-height: 1.9;
			}

			.prose :global(h2) {
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				padding-bottom: 0.3em;
				margin-top: 2em;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
			}

			.prose :global(h3) {
				color: var(--green);
				margin-top: 1.5em;
			}

			.prose :global(a) {
				color: var(--green);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.prose :global(a:hover) {
				color: #fff;
				text-shadow: 0 0 12px var(--green-glow);
				background: rgba(0, 255, 65, 0.1);
			}

			.prose :global(img) {
				display: none;
			}

			.prose :global(blockquote) {
				border-left: 3px solid var(--green);
				padding: 0.5em 1em;
				margin: 1.5em 0;
				color: var(--green-dim);
				background: rgba(0, 255, 65, 0.03);
			}

			.prose :global(code) {
				padding: 2px 6px;
				background: rgba(0, 255, 65, 0.1);
				border: 1px solid rgba(0, 255, 65, 0.2);
				border-radius: 3px;
				font-size: 0.9em;
			}

			.prose :global(pre) {
				padding: 1.5em;
				border: 1px solid rgba(0, 255, 65, 0.2);
				border-radius: 4px;
				background: rgba(0, 255, 65, 0.03);
				overflow-x: auto;
			}

			.prose :global(pre code) {
				all: unset;
			}

			.post-footer {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgba(0, 255, 65, 0.1);
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1em;
			}

			.back-link {
				display: inline-block;
				padding: 8px 18px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				text-decoration: none;
				color: var(--green);
				transition: all 0.2s;
			}

			.back-link:hover {
				background: rgba(0, 255, 65, 0.1);
				border-color: var(--green);
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.3);
			}

			.eof-marker {
				color: var(--green-dim);
				font-size: 0.85em;
			}

			@media (max-width: 700px) {
				.prose {
					padding: 1.5em;
				}
				.post-title {
					font-size: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas"></canvas>

		<!-- Navigation -->
		<nav class="top-bar">
			<span class="site-name">Northernhiwisen</span>
			<div class="top-nav">
				<a href="/">Homepage</a>
				<a href="/blog" class="active">Blog</a>
				<a href="/novel">Novel</a>
				<a href="/about">About</a>
			</div>
		</nav>

		<main>
			<article class="post-article">
				<div class="post-header">
					<h1 class="post-title">{title}</h1>
					<div class="post-meta">
						<span class="prompt">date:</span> <FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								<span class="separator">|</span>
								<span class="prompt">updated:</span> <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
				<div class="post-footer">
					<a href="/blog" class="back-link">← cd ../blog</a>
					<span class="eof-marker"><span class="prompt">EOF</span></span>
				</div>
			</article>
		</main>

		<Footer />

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.5);

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = Math.floor(window.innerHeight * 0.5);
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
