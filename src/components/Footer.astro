---
const today = new Date();
---

<footer class="terminal-footer">
	<div class="footer-line">
		<span class="footer-left">[{today.getFullYear()}] northernhiwisen@matrix</span>
		<span class="footer-right">Press <kbd>Ctrl+C</kbd> to exit</span>
	</div>
</footer>

<style>
	.terminal-footer {
		padding: 0.5em 1em;
		border-top: 1px solid rgba(0, 255, 65, 0.2);
		background: rgba(0, 255, 65, 0.03);
		margin-top: 2em;
	}

	.footer-line {
		display: flex;
		justify-content: space-between;
		align-items: center;
		max-width: 800px;
		margin: 0 auto;
		font-size: 12px;
		color: var(--green-dim);
	}

	.footer-right {
		font-style: italic;
	}

	kbd {
		padding: 1px 5px;
		border: 1px solid rgba(0, 255, 65, 0.3);
		border-radius: 3px;
		font-size: 11px;
		background: rgba(0, 255, 65, 0.05);
	}

	@media (max-width: 600px) {
		.footer-right {
			display: none;
		}
	}
</style>
