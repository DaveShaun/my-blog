---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const asciiPortrait = `
        ╔═══════════════╗
        ║   ██████████╗  ║
        ║   ██╔═════██╗ ║
        ║   █████╗  ██║ ║
        ║   ██╔══╝  ██║ ║
        ║   ███████╗██║ ║
        ║   ╚══════╝╚═╝ ║
        ╚═══════════════╝
           \\  ^__^
            \\ (oo)\\_______
              (__)\\       )\\/\\
                  ||----w |
                  ||     ||`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="About Me" description="About northernhiwisen - a curious builder exploring the digital world." />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: auto;
				padding: 1em;
			}

			.about-container {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				padding: 2em;
				background: rgba(0, 255, 65, 0.02);
			}

			.about-header {
				text-align: center;
				margin-bottom: 2em;
			}

			.section {
				margin-bottom: 2em;
			}

			.section-title {
				color: var(--green);
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				padding-bottom: 0.3em;
				margin-bottom: 1em;
			}

			.info-grid {
				display: grid;
				grid-template-columns: 120px 1fr;
				gap: 0.5em 1em;
			}

			.info-label {
				color: var(--green-dim);
			}

			.info-value {
				color: var(--green);
			}

			.skills-list {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.skill-tag {
				padding: 3px 10px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				border-radius: 3px;
				font-size: 0.85em;
				color: var(--green);
			}

			@media (max-width: 600px) {
				.about-container {
					padding: 1em;
				}
				.info-grid {
					grid-template-columns: 1fr;
					gap: 0.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="about-container">
				<div class="about-header">
					<pre class="ascii-art">{asciiPortrait}</pre>
					<span class="prompt">cat ~/.identity</span>
				</div>

				<div class="section">
					<h3 class="section-title">&gt; whoami</h3>
					<div class="info-grid">
						<span class="info-label">name:</span>
						<span class="info-value">northernhiwisen</span>
						<span class="info-label">location:</span>
						<span class="info-value">The Wired</span>
						<span class="info-label">status:</span>
						<span class="info-value">Building in the Matrix</span>
						<span class="info-label">interests:</span>
						<span class="info-value">Web, AI, Open Source, Tinkering</span>
					</div>
				</div>

				<div class="section">
					<h3 class="section-title">&gt; cat ~/.stack</h3>
					<div class="skills-list">
						<span class="skill-tag">Astro</span>
						<span class="skill-tag">TypeScript</span>
						<span class="skill-tag">React</span>
						<span class="skill-tag">Node.js</span>
						<span class="skill-tag">Cloudflare</span>
						<span class="skill-tag">GitHub Pages</span>
						<span class="skill-tag">AI Tools</span>
						<span class="skill-tag">Linux</span>
					</div>
				</div>

				<div class="section">
					<h3 class="section-title">&gt; cat ~/.story</h3>
					<p>
						A curious builder who started this blog with the help of AI assistants
						(OpenCode & MiMoCode), a free domain from DigitalPlat, and the Astro framework.
						Always exploring new technologies and building things that spark joy.
					</p>
					<p>
						This blog serves as my digital garden — a place to document the journey,
						share discoveries, and connect with fellow travelers in the Wired.
					</p>
				</div>

				<div class="section">
					<h3 class="section-title">&gt; ls ~/.links</h3>
					<div class="info-grid">
						<span class="info-label">github:</span>
						<span class="info-value"><a href="https://github.com/DaveShaun" target="_blank">github.com/DaveShaun</a></span>
						<span class="info-label">blog:</span>
						<span class="info-value">northernhiwisen.dpdns.org</span>
						<span class="info-label">rss:</span>
						<span class="info-value"><a href="/rss.xml">/rss.xml</a></span>
					</div>
				</div>
			</div>
		</main>
		Footer />
	</body>
</html>
