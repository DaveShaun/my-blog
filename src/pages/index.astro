---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';

const blogPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const novelPosts = (await getCollection('novel'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Northernhiwisen — Incurably curious about systems, logic, and aesthetics." />
		<style>
			main {
				width: 100%;
				max-width: 900px;
				margin: auto;
				padding: 0 1.5em;
			}

			/* Navigation */
			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				margin-bottom: 3em;
			}

			.site-name {
				margin: 0;
				line-height: 1.2;
			}

			.top-nav {
				display: flex;
				gap: 0.5em;
			}

			.top-nav a {
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				text-decoration: none;
				color: var(--green-dim);
				font-size: 0.9em;
				transition: all 0.2s;
			}

			.top-nav a:hover {
				color: var(--green);
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			/* Hero Section */
			.hero {
				text-align: center;
				padding: 4em 0 3em;
			}

			.hero-title {
				font-size: 3em;
				margin: 0 0 0.5em 0;
				color: var(--green);
				text-shadow: 0 0 20px var(--green-glow);
				letter-spacing: 2px;
			}

			.hero-ascii {
				font-size: 8px;
				line-height: 1.2;
				margin: 0 0 1.5em 0;
				text-align: center;
				overflow-x: auto;
			}

			@media (max-width: 700px) {
				.hero-ascii {
					font-size: 5px;
				}
			}

			.hero-subtitle {
				font-size: 1.1em;
				color: var(--green-dim);
				margin-bottom: 2em;
				line-height: 1.8;
			}

			.hero-desc {
				max-width: 600px;
				margin: 0 auto 2.5em;
				color: var(--green-dim);
				line-height: 2;
				font-size: 0.95em;
			}

			.hero-desc p {
				margin-bottom: 0.5em;
			}

			.hero-actions {
				display: flex;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
			}

			/* Section Styles */
			.section {
				padding: 3em 0;
				border-top: 1px solid rgba(0, 255, 65, 0.1);
			}

			.section-header {
				margin-bottom: 2em;
			}

			.section-label {
				font-size: 0.8em;
				color: var(--green-dim);
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 0.5em;
			}

			.section-title {
				font-size: 1.6em;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
				margin: 0;
			}

			/* Recent List */
			.recent-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.recent-item {
				display: flex;
				align-items: baseline;
				padding: 0.8em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.08);
				gap: 1em;
			}

			.recent-tag {
				display: inline-block;
				padding: 2px 8px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				border-radius: 3px;
				font-size: 0.75em;
				color: var(--green);
				white-space: nowrap;
				min-width: 50px;
				text-align: center;
			}

			.recent-title {
				color: var(--green);
				flex: 1;
			}

			.recent-title a {
				color: var(--green);
				text-decoration: none;
			}

			.recent-title a:hover {
				text-decoration: underline;
			}

			.recent-date {
				color: var(--green-dim);
				font-size: 0.85em;
				white-space: nowrap;
			}

	

			.empty-state {
				text-align: center;
				padding: 2em;
				color: var(--green-dim);
			}

			/* Footer */
			.footer {
				text-align: center;
				padding: 3em 0 2em;
				margin-top: 2em;
				border-top: 1px solid rgba(0, 255, 65, 0.15);
			}

			.footer-quote {
				font-style: italic;
				color: var(--green-dim);
				margin-bottom: 1em;
				font-size: 0.95em;
			}

			.footer-copy {
				color: rgba(0, 255, 65, 0.4);
				font-size: 0.8em;
			}

			/* Divider */
			.divider {
				border: none;
				border-top: 1px dashed rgba(0, 255, 65, 0.15);
				margin: 2em 0;
			}

			/* Responsive */
			@media (max-width: 700px) {
				.top-bar {
					flex-direction: column;
					gap: 1em;
				}

				.hero-title {
					font-size: 2em;
				}

				.recent-item {
					flex-direction: column;
					gap: 0.3em;
				}

				.recent-date {
					align-self: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas" style="position:fixed;top:0;left:0;width:100%;height:66vh;z-index:0;opacity:0.3;pointer-events:none;"></canvas>

		<main>
			<!-- Navigation -->
			<nav class="top-bar">
				<span class="site-name">Northernhiwisen</span>
				<div class="top-nav">
					<a href="/" class="active">Homepage</a>
					<a href="/blog">Blog</a>
					<a href="/novel">Novel</a>
					<a href="/about">About</a>
				</div>
			</nav>

			<!-- Hero Section -->
			<section class="hero">
				<pre class="ascii-art hero-ascii">███╗   ██╗ ██████╗ ██████╗ ████████╗██╗  ██╗███████╗██████╗ ███╗   ██╗██╗  ██╗██╗██╗    ██╗██╗███████╗███████╗███╗   ██╗
████╗  ██║██╔═══██╗██╔══██╗╚══██╔══╝██║  ██║██╔════╝██╔══██╗████╗  ██║██║  ██║██║██║    ██║██║██╔════╝██╔════╝████╗  ██║
██╔██╗ ██║██║   ██║██████╔╝   ██║   ███████║█████╗  ██████╔╝██╔██╗ ██║███████║██║██║ █╗ ██║██║███████╗█████╗  ██╔██╗ ██║
██║╚██╗██║██║   ██║██╔══██╗   ██║   ██╔══██║██╔══╝  ██╔══██╗██║╚██╗██║██╔══██║██║██║███╗██║██║╚════██║██╔══╝  ██║╚██╗██║
██║ ╚████║╚██████╔╝██║  ██║   ██║   ██║  ██║███████╗██║  ██║██║ ╚████║██║  ██║██║╚███╔███╔╝██║███████║███████╗██║ ╚████║
╚═╝  ╚═══╝ ╚═════╝ ╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝  ╚═╝╚═╝ ╚══╝╚══╝  ╚═╝╚══════╝╚══════╝╚═╝  ╚═══╝</pre>
				<p class="hero-subtitle">
					Incurably curious about systems, logic, and aesthetics.
				</p>
				<div class="hero-desc">
					<p>嗨，大家好！我是一个专利工程师，最近一直在做有关Agent的项目，所以也用Agent帮我构建了这个博客。</p>
					<p>我暂时想把这个博客作为记录我使用Agent经历，以及日常文章的展示场所</p>
				</div>
			</section>

			<hr class="divider" />

			<!-- Section 3: Latest Blog Posts -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 01</div>
					<h2 class="section-title">Latest Blog / 最新博客</h2>
				</div>

				<ul class="recent-list">
					{blogPosts.length === 0 ? (
						<li class="empty-state">No blog posts yet.</li>
					) : (
						blogPosts.map((post) => {
							const date = post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });
							return (
								<li class="recent-item">
									<span class="recent-tag">[文章]</span>
									<span class="recent-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></span>
									<span class="recent-date">{date}</span>
								</li>
							);
						})
					)}
				</ul>
			</section>

			<hr class="divider" />

			<!-- Section 4: Latest Novel Posts -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 02</div>
					<h2 class="section-title">Latest Novel / 最新小说</h2>
				</div>

				<ul class="recent-list">
					{novelPosts.length === 0 ? (
						<li class="empty-state">No novel posts yet.</li>
					) : (
						novelPosts.map((post) => {
							const date = post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });
							return (
								<li class="recent-item">
									<span class="recent-tag">[小说]</span>
									<span class="recent-title"><a href={`/novel/${post.id}/`}>{post.data.title}</a></span>
									<span class="recent-date">{date}</span>
								</li>
							);
						})
					)}
				</ul>
			</section>

			<!-- Footer -->
			<footer class="footer">
				<p class="footer-quote">"复杂性不是终点，而是探索的起点。"</p>
				<p class="footer-copy">&copy; 2026 Northernhiwisen. Powered by Curiosity.</p>
			</footer>
		</main>

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.66);

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 18;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = Math.floor(window.innerHeight * 0.66);
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
