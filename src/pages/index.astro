---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Northernhiwisen — Incurably curious about systems, logic, and aesthetics." />
		<style>
			main {
				width: 100%;
				max-width: 900px;
				margin: auto;
				padding: 0 1.5em;
			}

			/* Navigation */
			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				margin-bottom: 3em;
			}

			.site-name {
				font-size: 1.1em;
				font-weight: bold;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
			}

			.site-name::before {
				content: '> ';
				color: var(--green-dim);
			}

			.top-nav {
				display: flex;
				gap: 0.5em;
			}

			.top-nav a {
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				text-decoration: none;
				color: var(--green-dim);
				font-size: 0.9em;
				transition: all 0.2s;
			}

			.top-nav a:hover {
				color: var(--green);
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			/* Hero Section */
			.hero {
				text-align: center;
				padding: 4em 0 3em;
			}

			.hero-title {
				font-size: 3em;
				margin: 0 0 0.5em 0;
				color: var(--green);
				text-shadow: 0 0 20px var(--green-glow);
				letter-spacing: 2px;
			}

			.hero-subtitle {
				font-size: 1.1em;
				color: var(--green-dim);
				margin-bottom: 2em;
				line-height: 1.8;
			}

			.hero-desc {
				max-width: 600px;
				margin: 0 auto 2.5em;
				color: var(--green-dim);
				line-height: 2;
				font-size: 0.95em;
			}

			.hero-desc p {
				margin-bottom: 0.5em;
			}

			.hero-actions {
				display: flex;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
			}

			.btn {
				display: inline-block;
				padding: 10px 24px;
				border: 1px solid var(--green);
				text-decoration: none;
				font-size: 0.9em;
				transition: all 0.2s;
				cursor: pointer;
			}

			.btn-primary {
				color: #000;
				background: var(--green);
				font-weight: bold;
			}

			.btn-primary:hover {
				background: #fff;
				border-color: #fff;
				box-shadow: 0 0 20px var(--green-glow);
			}

			.btn-secondary {
				color: var(--green);
				background: transparent;
			}

			.btn-secondary:hover {
				background: rgba(0, 255, 65, 0.1);
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.3);
			}

			/* Section Styles */
			.section {
				padding: 3em 0;
				border-top: 1px solid rgba(0, 255, 65, 0.1);
			}

			.section-header {
				margin-bottom: 2em;
			}

			.section-label {
				font-size: 0.8em;
				color: var(--green-dim);
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 0.5em;
			}

			.section-title {
				font-size: 1.6em;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
				margin: 0;
			}

			/* Expertise List */
			.expertise-item {
				margin-bottom: 2.5em;
				padding-left: 1.5em;
				border-left: 2px solid rgba(0, 255, 65, 0.2);
			}

			.expertise-item:hover {
				border-left-color: var(--green);
			}

			.expertise-number {
				font-size: 0.8em;
				color: var(--green-dim);
				margin-bottom: 0.3em;
			}

			.expertise-title {
				font-size: 1.2em;
				color: var(--green);
				margin: 0 0 0.5em 0;
			}

			.expertise-desc {
				color: var(--green-dim);
				line-height: 1.8;
				margin: 0;
			}

			/* Explore Cards */
			.card-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5em;
			}

			.card {
				border: 1px solid rgba(0, 255, 65, 0.2);
				padding: 1.5em;
				transition: all 0.2s;
				background: rgba(0, 255, 65, 0.02);
			}

			.card:hover {
				border-color: var(--green);
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.15);
				transform: translateY(-2px);
			}

			.card-title {
				font-size: 1.1em;
				color: var(--green);
				margin: 0 0 0.8em 0;
				padding-bottom: 0.5em;
				border-bottom: 1px solid rgba(0, 255, 65, 0.15);
			}

			.card-topics {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.card-topics li {
				color: var(--green-dim);
				font-size: 0.9em;
				padding: 0.3em 0;
			}

			.card-topics li::before {
				content: '├─ ';
				color: rgba(0, 255, 65, 0.4);
			}

			.card-topics li:last-child::before {
				content: '└─ ';
			}

			/* Recent List */
			.recent-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.recent-item {
				display: flex;
				align-items: baseline;
				padding: 0.8em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.08);
				gap: 1em;
			}

			.recent-tag {
				display: inline-block;
				padding: 2px 8px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				border-radius: 3px;
				font-size: 0.75em;
				color: var(--green);
				white-space: nowrap;
				min-width: 50px;
				text-align: center;
			}

			.recent-title {
				color: var(--green);
				flex: 1;
			}

			.recent-title a {
				color: var(--green);
				text-decoration: none;
			}

			.recent-title a:hover {
				text-decoration: underline;
			}

			.recent-date {
				color: var(--green-dim);
				font-size: 0.85em;
				white-space: nowrap;
			}

			/* Footer */
			.footer {
				text-align: center;
				padding: 3em 0 2em;
				margin-top: 2em;
				border-top: 1px solid rgba(0, 255, 65, 0.15);
			}

			.footer-quote {
				font-style: italic;
				color: var(--green-dim);
				margin-bottom: 1em;
				font-size: 0.95em;
			}

			.footer-copy {
				color: rgba(0, 255, 65, 0.4);
				font-size: 0.8em;
			}

			/* Divider */
			.divider {
				border: none;
				border-top: 1px dashed rgba(0, 255, 65, 0.15);
				margin: 2em 0;
			}

			/* Responsive */
			@media (max-width: 700px) {
				.top-bar {
					flex-direction: column;
					gap: 1em;
				}

				.hero-title {
					font-size: 2em;
				}

				.card-grid {
					grid-template-columns: 1fr;
				}

				.recent-item {
					flex-direction: column;
					gap: 0.3em;
				}

				.recent-date {
					align-self: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas"></canvas>

		<main>
			<!-- Navigation -->
			<nav class="top-bar">
				<span class="site-name">Northernhiwisen</span>
				<div class="top-nav">
					<a href="/" class="active">Homepage</a>
					<a href="/blog">Blog</a>
					<a href="/novel">Novel</a>
					<a href="/about">About</a>
				</div>
			</nav>

			<!-- Hero Section -->
			<section class="hero">
				<h1 class="hero-title">Northernhiwisen</h1>
				<p class="hero-subtitle">
					Incurably curious about systems, logic, and aesthetics.
				</p>
				<div class="hero-desc">
					<p>穿梭于专利数据库与复杂规则之间的信息检索人。</p>
					<p>左手逻辑：深挖技术哲学、系统工程与底层机制；</p>
					<p>右手感性：探索音乐编曲、硬核叙事与格律美学。</p>
					<p>致力于用极度的严谨去拆解复杂，用独立的视角去探索世界。</p>
				</div>
				<div class="hero-actions">
					<a href="#section-expertise" class="btn btn-primary">Explore My Work ↓</a>
					<a href="mailto:contact@northernhiwisen.dpdns.org" class="btn btn-secondary">Get in Touch</a>
				</div>
			</section>

			<hr class="divider" />

			<!-- Section 1: What I Do -->
			<section class="section" id="section-expertise">
				<div class="section-header">
					<div class="section-label">// SECTION 01</div>
					<h2 class="section-title">What I Do / 专业领域</h2>
				</div>

				<div class="expertise-item">
					<div class="expertise-number">01 / Patent & Database Retrieval</div>
					<h3 class="expertise-title">专利与数据库检索</h3>
					<p class="expertise-desc">
						深耕专利系统与文献数据库，擅长复杂检索式构建、现有技术查新与证据链梳理。
					</p>
				</div>

				<div class="expertise-item">
					<div class="expertise-number">02 / Information Architecture & Systems</div>
					<h3 class="expertise-title">信息架构与系统拆解</h3>
					<p class="expertise-desc">
						以极度的严谨性梳理规则、数据与机制，从浩瀚的信息海洋中建立秩序。
					</p>
				</div>
			</section>

			<hr class="divider" />

			<!-- Section 2: What I Explore -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 02</div>
					<h2 class="section-title">What I Explore / 探索与思考</h2>
				</div>

				<div class="card-grid">
					<div class="card">
						<h3 class="card-title">逻辑与系统</h3>
						<ul class="card-topics">
							<li>技术哲学</li>
							<li>系统工程历史</li>
						</ul>
					</div>
					<div class="card">
						<h3 class="card-title">音乐与音墙</h3>
						<ul class="card-topics">
							<li>DAW 多轨编曲</li>
							<li>MIDI 机制与声学</li>
						</ul>
					</div>
					<div class="card">
						<h3 class="card-title">文本与格律</h3>
						<ul class="card-topics">
							<li>硬派侦探小说</li>
							<li>古诗词平仄格律</li>
						</ul>
					</div>
				</div>
			</section>

			<hr class="divider" />

			<!-- Section 3: Recent Notes & Projects -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 03</div>
					<h2 class="section-title">Recent Notes & Projects / 近期产出</h2>
				</div>

				<ul class="recent-list">
					<li class="recent-item">
						<span class="recent-tag">[文章]</span>
						<span class="recent-title"><a href="/blog/my-first-post">我的建站之旅：从免费域名到 AI 助攻</a></span>
						<span class="recent-date">2026.08</span>
					</li>
					<li class="recent-item">
						<span class="recent-tag">[音轨]</span>
						<span class="recent-title">MIDI 多轨堆叠与音墙实验 (Waveform 13)</span>
						<span class="recent-date">2026.06</span>
					</li>
					<li class="recent-item">
						<span class="recent-tag">[笔记]</span>
						<span class="recent-title">侦探小说词汇结构与文本张力</span>
						<span class="recent-date">2026.05</span>
					</li>
				</ul>
			</section>

			<!-- Footer -->
			<footer class="footer">
				<p class="footer-quote">"复杂性不是终点，而是探索的起点。"</p>
				<p class="footer-copy">&copy; 2026 Northernhiwisen. Powered by Curiosity.</p>
			</footer>
		</main>

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.5);

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = Math.floor(window.innerHeight * 0.5);
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
