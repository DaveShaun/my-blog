---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Reset global styles for Matrix theme */
			body {
				margin: 0;
				padding: 0;
				background: #000 !important;
				color: #00ff41 !important;
				font-family: 'Courier New', Courier, monospace !important;
				overflow: hidden;
				min-height: 100vh;
			}

			main {
				width: 100% !important;
				max-width: 100% !important;
				margin: 0 !important;
				padding: 0 !important;
			}

			/* Matrix rain canvas */
			#matrix-canvas {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				z-index: 0;
				opacity: 0.15;
			}

			/* Terminal container */
			.terminal-wrapper {
				position: relative;
				z-index: 1;
				display: flex;
				justify-content: center;
				align-items: center;
				min-height: 100vh;
				padding: 1rem;
			}

			.terminal {
				width: 100%;
				max-width: 700px;
				background: rgba(0, 0, 0, 0.85);
				border: 1px solid #00ff41;
				border-radius: 8px;
				box-shadow:
					0 0 20px rgba(0, 255, 65, 0.15),
					inset 0 0 60px rgba(0, 255, 65, 0.03);
				backdrop-filter: blur(2px);
				overflow: hidden;
			}

			/* Terminal title bar */
			.terminal-bar {
				display: flex;
				align-items: center;
				gap: 8px;
				padding: 10px 16px;
				background: rgba(0, 255, 65, 0.08);
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
			}

			.terminal-bar .dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
			}

			.dot-red { background: #ff5f56; }
			.dot-yellow { background: #ffbd2e; }
			.dot-green { background: #27c93f; }

			.terminal-title {
				margin-left: 12px;
				font-size: 13px;
				color: rgba(0, 255, 65, 0.5);
				user-select: none;
			}

			/* Terminal body */
			.terminal-body {
				padding: 24px;
				font-size: 15px;
				line-height: 1.8;
				min-height: 320px;
			}

			.terminal-body .line {
				opacity: 0;
				animation: fadeIn 0.3s ease forwards;
			}

			@keyframes fadeIn {
				to { opacity: 1; }
			}

			.terminal-body .prompt {
				color: #00ff41;
				text-shadow: 0 0 8px rgba(0, 255, 65, 0.6);
			}

			.terminal-body .command {
				color: #00ff41;
			}

			.terminal-body .output {
				color: rgba(0, 255, 65, 0.75);
				padding-left: 16px;
			}

			.terminal-body .error {
				color: #ff5f56;
			}

			/* Links styled as terminal links */
			.terminal-body a {
				color: #00ff41;
				text-decoration: underline;
				text-underline-offset: 3px;
				transition: all 0.2s;
			}

			.terminal-body a:hover {
				color: #fff;
				text-shadow: 0 0 12px rgba(0, 255, 65, 0.8);
				background: rgba(0, 255, 65, 0.1);
			}

			/* Navigation grid */
			.nav-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
				gap: 12px;
				margin-top: 8px;
			}

			.nav-grid a {
				display: block;
				padding: 8px 14px;
				border: 1px solid rgba(0, 255, 65, 0.3);
				text-decoration: none;
				color: #00ff41;
				text-align: center;
				transition: all 0.2s;
			}

			.nav-grid a:hover {
				background: rgba(0, 255, 65, 0.1);
				border-color: #00ff41;
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.3);
			}

			/* Blinking cursor */
			.cursor {
				display: inline-block;
				width: 10px;
				height: 18px;
				background: #00ff41;
				animation: blink 1s step-end infinite;
				vertical-align: middle;
				margin-left: 2px;
			}

			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}

			/* ASCII art header */
			.ascii-art {
				color: #00ff41;
				text-shadow: 0 0 8px rgba(0, 255, 65, 0.6);
				font-size: 12px;
				line-height: 1.2;
				white-space: pre;
				margin-bottom: 8px;
			}

			/* Scanline effect */
			.scanline {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				pointer-events: none;
				z-index: 2;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(0, 0, 0, 0.03) 2px,
					rgba(0, 0, 0, 0.03) 4px
				);
			}

			/* Responsive */
			@media (max-width: 600px) {
				.terminal-body {
					padding: 16px;
					font-size: 13px;
				}
				.ascii-art {
					font-size: 9px;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas"></canvas>
		<div class="scanline"></div>

		<main>
			<div class="terminal-wrapper">
				<div class="terminal">
					<div class="terminal-bar">
						<span class="dot dot-red"></span>
						<span class="dot dot-yellow"></span>
						<span class="dot dot-green"></span>
						<span class="terminal-title">northernhiwisen@matrix ~ </span>
					</div>
					<div class="terminal-body">
						<div class="line">
							<pre class="ascii-art"> _   _ _             _              
| \ | (_)           | |             
|  \| |_ _ __   ___ | |_ ___  _ __  
| . ` | | '_ \ / _ \| __/ _ \| '__| 
| |\  | | | | | (_) | || (_) | |    
|_| \_|_|_| |_|\___/ \__\___/|_|    </pre>
						</div>

						<div class="line" style="animation-delay: 0.2s">
							<span class="prompt">$</span>
							<span class="command"> whoami</span>
						</div>
						<div class="line" style="animation-delay: 0.5s">
							<span class="output">northernhiwisen — a curious builder exploring the digital world.</span>
						</div>

						<div class="line" style="animation-delay: 0.8s">
							<span class="prompt">$</span>
							<span class="command"> cat about.md</span>
						</div>
						<div class="line" style="animation-delay: 1.1s">
							<span class="output">Welcome to my corner of the internet. I built this blog with AI assistants (OpenCode & MiMoCode), a free domain from DigitalPlat, and the Astro framework.</span>
						</div>

						<div class="line" style="animation-delay: 1.4s">
							<span class="prompt">$</span>
							<span class="command"> ls nav/</span>
						</div>
						<div class="line" style="animation-delay: 1.7s">
							<span class="output">
								<div class="nav-grid">
									<a href="/blog">./blog</a>
									<a href="/about">./about</a>
									<a href="/rss.xml">./rss</a>
								</div>
							</span>
						</div>

						<div class="line" style="animation-delay: 2.0s">
							<span class="prompt">$</span>
							<span class="command"> echo $STATUS</span>
						</div>
						<div class="line" style="animation-delay: 2.3s">
							<span class="output">Building in progress... <span class="cursor"></span></span>
						</div>
					</div>
				</div>
			</div>
		</main>

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = window.innerHeight;

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = window.innerHeight;
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
