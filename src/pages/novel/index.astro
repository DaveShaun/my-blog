---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';

const novels = (await getCollection('novel')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Password hash placeholder - replace with actual hash after setting password
const PASSWORD_HASH = 'PLACEHOLDER_HASH';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Novel & Creative Writing" description="小说与创意写作 — 探索音乐编曲、硬核叙事与格律美学。" />
		<style>
			main {
				width: 100%;
				max-width: 900px;
				margin: auto;
				padding: 0 1.5em;
			}

			/* Password Gate */
			.password-gate {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.95);
				display: flex;
				justify-content: center;
				align-items: center;
				z-index: 1000;
				flex-direction: column;
				gap: 1.5em;
			}

			.password-gate h2 {
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
			}

			.password-gate .password-form {
				display: flex;
				flex-direction: column;
				gap: 1em;
				align-items: center;
			}

			.password-gate input[type="password"] {
				padding: 12px 16px;
				background: rgba(0, 255, 65, 0.05);
				border: 1px solid rgba(0, 255, 65, 0.3);
				color: var(--green);
				font-family: var(--font-mono);
				font-size: 1em;
				width: 280px;
				outline: none;
			}

			.password-gate input[type="password"]:focus {
				border-color: var(--green);
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.3);
			}

			.password-gate button {
				padding: 10px 24px;
				background: transparent;
				border: 1px solid var(--green);
				color: var(--green);
				font-family: var(--font-mono);
				font-size: 0.9em;
				cursor: pointer;
				transition: all 0.2s;
			}

			.password-gate button:hover {
				background: rgba(0, 255, 65, 0.1);
				box-shadow: 0 0 12px rgba(0, 255, 65, 0.3);
			}

			.password-gate .error {
				color: #ff5f56;
				font-size: 0.85em;
				min-height: 1.2em;
			}

			/* Navigation */
			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				margin-bottom: 2em;
			}

			.site-name {
				margin: 0;
				line-height: 1.2;
			}

			.top-nav {
				display: flex;
				gap: 0.5em;
			}

			.top-nav a {
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				text-decoration: none;
				color: var(--green-dim);
				font-size: 0.9em;
				transition: all 0.2s;
			}

			.top-nav a:hover,
			.top-nav a.active {
				color: var(--green);
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			/* Section */
			.section {
				padding: 3em 0;
				border-top: 1px solid rgba(0, 255, 65, 0.1);
			}

			.section:first-child {
				border-top: none;
			}

			.section-header {
				margin-bottom: 2em;
			}

			.section-label {
				font-size: 0.8em;
				color: var(--green-dim);
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 0.5em;
			}

			.section-title {
				font-size: 1.6em;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
				margin: 0;
			}

			/* Novel List */
			.novels-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.novel-item {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				margin-bottom: 1.2em;
				padding: 1.5em 1.8em;
				transition: all 0.2s;
				background: rgba(0, 255, 65, 0.02);
			}

			.novel-item:hover {
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.15);
				transform: translateY(-2px);
			}

			.novel-item a {
				text-decoration: none;
				display: block;
			}

			.novel-item .title {
				font-size: 1.2em;
				margin: 0 0 0.4em 0;
				color: var(--green);
				text-shadow: 0 0 6px var(--green-glow);
			}

			.novel-item .pwd-hint {
				font-size: 0.7em;
				color: var(--green-dim);
				text-shadow: none;
				opacity: 0.7;
			}

			.novel-item .excerpt {
				color: var(--green-dim);
				font-size: 0.9em;
				margin: 0.5em 0;
				line-height: 1.7;
			}

			.novel-item .meta {
				font-size: 0.8em;
				color: rgba(0, 255, 65, 0.5);
				display: flex;
				align-items: center;
				gap: 1em;
			}

			.novel-item .meta .tag {
				display: inline-block;
				padding: 2px 8px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				border-radius: 3px;
				font-size: 0.9em;
			}

			.novel-item .meta .path {
				font-style: italic;
			}

			.empty-state {
				text-align: center;
				padding: 3em;
				color: var(--green-dim);
			}

			@media (max-width: 700px) {
				.novel-item {
					padding: 1.2em;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas" style="position:fixed;top:0;left:0;width:100%;height:50vh;z-index:0;opacity:0.15;pointer-events:none;"></canvas>

		<!-- Password Gate -->
		<div id="password-gate" class="password-gate">
			<h2>🔒 Novel 栏目需要密码访问</h2>
			<div class="password-form">
				<input type="password" id="password-input" placeholder="输入访问密码..." />
				<button id="unlock-btn">解锁</button>
				<p id="error-msg" class="error"></p>
			</div>
		</div>

		<!-- Navigation -->
		<nav class="top-bar">
			<pre class="site-name ascii-art"> _   _  _  ___  _   _ ___ _   _ ___ _   _  _   _ ___ _   _
| \ | || \| _ \|\  / /|_ _| \| ||_ _| \| || \ | ||_ _| \| |
|   ||    |  _/ \ V /  | ||    || ||    ||   ||  _/|    |
|_|\_||_|\_|___|  \_/  |___||_|\_||_|\__||_|\_|___||_|\_|</pre>
			<div class="top-nav">
				<a href="/">Homepage</a>
				<a href="/blog">Blog</a>
				<a href="/novel" class="active">Novel</a>
				<a href="/about">About</a>
			</div>
		</nav>

		<main>
			<!-- Section: Novels -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 01</div>
					<h2 class="section-title">Novel & Creative Writing / 小说与创意写作</h2>
				</div>

				<ul class="novels-list">
					{novels.length === 0 ? (
						<li class="empty-state">
							<span class="prompt">cat: ./novels/*</span>
							<p>No novels found. Directory is empty.</p>
						</li>
					) : (
						novels.map((novel) => {
							const pwd = novel.data.pubDate.toISOString().slice(0, 10).replace(/-/g, '');
							return (
								<li class="novel-item">
									<a href={`/novel/${novel.id}/`}>
										<h3 class="title">{novel.data.title} <span class="pwd-hint">({pwd})</span></h3>
										<p class="excerpt">{novel.data.description}</p>
										<div class="meta">
											<span class="path">~/novel/{novel.id}</span>
										</div>
									</a>
								</li>
							);
						})
					)}
				</ul>
			</section>
		</main>

		<Footer />

		<script>
			const gate = document.getElementById('password-gate');
			const passwordInput = document.getElementById('password-input');
			const unlockBtn = document.getElementById('unlock-btn');
			const errorMsg = document.getElementById('error-msg');

			function getTodayPassword() {
				return new Date().toISOString().slice(0, 10).replace(/-/g, '');
			}

			function hideGate() {
				gate.style.display = 'none';
			}

			function showError(msg) {
				errorMsg.textContent = msg;
			}

			if (sessionStorage.getItem('novel_auth') === 'true') {
				hideGate();
			}

			unlockBtn.addEventListener('click', () => {
				const password = passwordInput.value;
				if (!password) {
					showError('请输入密码');
					return;
				}
				if (password === getTodayPassword()) {
					sessionStorage.setItem('novel_auth', 'true');
					hideGate();
				} else {
					showError('密码错误，请重试');
					passwordInput.value = '';
					passwordInput.focus();
				}
			});

			passwordInput.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					unlockBtn.click();
				}
			});
		</script>

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.5);

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = Math.floor(window.innerHeight * 0.5);
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
