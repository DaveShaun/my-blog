---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
	const novels = await getCollection('novel');
	return novels.map((novel) => ({
		params: { slug: novel.id },
		props: novel,
	}));
}

const post = Astro.props;
const { title, description, pubDate, ciphertext } = post.data;

const formatted = pubDate.toLocaleDateString('en-us', {
	year: 'numeric',
	month: 'short',
	day: 'numeric',
});

const PASSWORD_HASH = 'PLACEHOLDER_HASH';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main { width: 100%; max-width: 900px; margin: auto; padding: 0 1.5em; }
			.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 1.5em 0; border-bottom: 1px solid rgba(0,255,65,0.2); margin-bottom: 2em; }
			.site-name { margin: 0; line-height: 1.2; }
			.top-nav { display: flex; gap: 0.5em; }
			.top-nav a { padding: 6px 14px; border: 1px solid rgba(0,255,65,0.2); text-decoration: none; color: var(--green-dim); font-size: 0.9em; transition: all 0.2s; }
			.top-nav a:hover, .top-nav a.active { color: var(--green); border-color: var(--green); background: rgba(0,255,65,0.05); box-shadow: 0 0 10px rgba(0,255,65,0.2); }
			.password-gate { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); display: flex; justify-content: center; align-items: center; z-index: 1000; flex-direction: column; gap: 1.5em; }
			.password-gate h2 { color: var(--green); text-shadow: 0 0 8px var(--green-glow); }
			.password-gate .password-form { display: flex; flex-direction: column; gap: 1em; align-items: center; }
			.password-gate input[type="password"] { padding: 12px 16px; background: rgba(0,255,65,0.05); border: 1px solid rgba(0,255,65,0.3); color: var(--green); font-family: var(--font-mono); font-size: 1em; width: 280px; outline: none; }
			.password-gate input[type="password"]:focus { border-color: var(--green); box-shadow: 0 0 12px rgba(0,255,65,0.3); }
			.password-gate button { padding: 10px 24px; background: transparent; border: 1px solid var(--green); color: var(--green); font-family: var(--font-mono); font-size: 0.9em; cursor: pointer; transition: all 0.2s; }
			.password-gate button:hover { background: rgba(0,255,65,0.1); box-shadow: 0 0 12px rgba(0,255,65,0.3); }
			.password-gate .error { color: #ff5f56; font-size: 0.85em; min-height: 1.2em; }
			.post-article { padding: 3em 0; }
			.post-header { text-align: center; margin-bottom: 3em; padding-bottom: 2em; border-bottom: 1px solid rgba(0,255,65,0.1); }
			.post-title { font-size: 2em; margin: 1em 0 0.5em 0; text-shadow: 0 0 12px var(--green-glow); color: var(--green); line-height: 1.3; }
			.post-meta { color: var(--green-dim); font-size: 0.9em; }
			.prose { border: 1px solid rgba(0,255,65,0.15); border-radius: 4px; padding: 2.5em; background: rgba(0,255,65,0.02); line-height: 1.9; }
			.decrypt-btn { display: inline-block; margin-top: 1.5em; padding: 8px 18px; border: 1px solid rgba(0,255,65,0.3); text-decoration: none; color: var(--green); transition: all 0.2s; cursor: pointer; background: transparent; font-family: var(--font-mono); font-size: 0.9em; }
			.decrypt-btn:hover { background: rgba(0,255,65,0.1); border-color: var(--green); box-shadow: 0 0 12px rgba(0,255,65,0.3); }
			.encrypted-display { border: 1px dashed rgba(0,255,65,0.3); padding: 1.5em; margin: 1.5em 0; font-size: 0.8em; color: var(--green-dim); word-break: break-all; max-height: 120px; overflow: hidden; opacity: 0.5; }
			.post-footer { margin-top: 2.5em; padding-top: 1.5em; border-top: 1px solid rgba(0,255,65,0.1); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1em; }
			.back-link { display: inline-block; padding: 8px 18px; border: 1px solid rgba(0,255,65,0.3); text-decoration: none; color: var(--green); transition: all 0.2s; }
			.back-link:hover { background: rgba(0,255,65,0.1); border-color: var(--green); box-shadow: 0 0 12px rgba(0,255,65,0.3); }
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas" style="position:fixed;top:0;left:0;width:100%;height:50vh;z-index:0;opacity:0.15;pointer-events:none;"></canvas>

		<div id="password-gate" class="password-gate">
			<h2>🔒 此内容已加密</h2>
			<div class="password-form">
				<input type="password" id="password-input" placeholder="输入访问密码..." />
				<button id="unlock-btn">解锁</button>
				<p id="error-msg" class="error"></p>
			</div>
		</div>

		<nav class="top-bar">
			<pre class="site-name ascii-art"> _   _  _  ___  _   _ ___ _   _ ___ _   _  _   _ ___ _   _
| \ | || \| _ \|\  / /|_ _| \| ||_ _| \| || \ | ||_ _| \| |
|   ||    |  _/ \ V /  | ||    || ||    ||   ||  _/|    |
|_|\_||_|\_|___|  \_/  |___||_|\_||_|\__||_|\_|___||_|\_|</pre>
			<div class="top-nav">
				<a href="/">Homepage</a>
				<a href="/blog">Blog</a>
				<a href="/novel" class="active">Novel</a>
				<a href="/about">About</a>
			</div>
		</nav>

		<main>
			<article class="post-article">
				<div class="post-header">
					<h1 class="post-title">{title}</h1>
					<div class="post-meta"><span class="prompt">date:</span> [{formatted}]</div>
				</div>
				<div class="prose" id="content-area">
					<div class="encrypted-display" id="encrypted-display">{ciphertext}</div>
					<button class="decrypt-btn" id="decrypt-btn">🔓 点击解密内容</button>
					<div id="decrypted-content"></div>
				</div>
				<div class="post-footer">
					<a href="/novel" class="back-link">← cd ../novel</a>
					<span class="eof-marker"><span class="prompt">EOF</span></span>
				</div>
			</article>
		</main>

		<Footer />

		<script>
			const ENCRYPTED_CONTENT = '{ciphertext}';

			const gate = document.getElementById('password-gate');
			const passwordInput = document.getElementById('password-input');
			const unlockBtn = document.getElementById('unlock-btn');
			const errorMsg = document.getElementById('error-msg');
			const decryptBtn = document.getElementById('decrypt-btn');
			const decryptedContent = document.getElementById('decrypted-content');
			const encryptedDisplay = document.getElementById('encrypted-display');

			function getTodayPassword() {
				return new Date().toISOString().slice(0, 10).replace(/-/g, '');
			}

			function hideGate() { gate.style.display = 'none'; }
			function showError(msg) { errorMsg.textContent = msg; }

			if (sessionStorage.getItem('novel_auth') === 'true') { hideGate(); }

			unlockBtn.addEventListener('click', () => {
				const password = passwordInput.value;
				if (!password) { showError('请输入密码'); return; }
				if (password === getTodayPassword()) {
					sessionStorage.setItem('novel_auth', 'true');
					hideGate();
				} else {
					showError('密码错误，请重试');
					passwordInput.value = '';
					passwordInput.focus();
				}
			});

			passwordInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') unlockBtn.click(); });

			decryptBtn.addEventListener('click', async () => {
				const password = passwordInput.value || prompt('请输入解密密码:');
				if (!password) return;
				try {
					const SALT = 'novel-salt-2026';
					const ITERATIONS = 100000;
					const encoder = new TextEncoder();
					const keyMaterial = await crypto.subtle.importKey('raw', encoder.encode(password), 'PBKDF2', false, ['deriveKey']);
					const key = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: encoder.encode(SALT), iterations: ITERATIONS, hash: 'SHA-256' }, keyMaterial, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
					const combined = Uint8Array.from(atob(ENCRYPTED_CONTENT), c => c.charCodeAt(0));
					const iv = combined.slice(0, 12);
					const ciphertextData = combined.slice(12);
					const plaintext = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ciphertextData);
					decryptedContent.innerHTML = '<div>' + new TextDecoder().decode(plaintext).replace(/\n/g, '<br>') + '</div>';
					encryptedDisplay.style.display = 'none';
					decryptBtn.style.display = 'none';
				} catch {
					alert('解密失败：密码错误或内容损坏');
				}
			});
		</script>

		<script>
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');
			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.5);
			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);
			window.addEventListener('resize', () => { width = canvas.width = window.innerWidth; height = canvas.height = Math.floor(window.innerHeight * 0.5); });
			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);
				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';
				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);
					if (drops[i] * fontSize > height && Math.random() > 0.975) drops[i] = 0;
					drops[i]++;
				}
			}
			setInterval(draw, 33);
		</script>
	</body>
</html>
