---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const asciiHeader = `
 ╔═══════════════════════════════════════╗
 ║   __  __ _      __  __                ║
 ║  |  \\/  (_)___ |  \\/  |___  ___       ║
 ║  | |\\/| | / __|| |\\/| / __|/ _ \\      ║
 ║  | |  | | \\__ \\| |  | \\__ \\ (_) |     ║
 ║  |_|  |_|_|___/|_|  |_|___/\\___/      ║
 ╚═══════════════════════════════════════╝`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 800px;
				margin: auto;
				padding: 1em;
			}

			.page-header {
				text-align: center;
				margin-bottom: 2em;
			}

			.posts-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.post-item {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				margin-bottom: 1em;
				padding: 1.2em 1.5em;
				transition: all 0.2s;
				background: rgba(0, 255, 65, 0.02);
			}

			.post-item:hover {
				border-color: rgba(0, 255, 65, 0.4);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.1);
			}

			.post-item a {
				text-decoration: none;
				display: block;
			}

			.post-item .title {
				font-size: 1.2em;
				margin: 0 0 0.3em 0;
				color: var(--green);
				text-shadow: 0 0 6px var(--green-glow);
			}

			.post-item .excerpt {
				color: var(--green-dim);
				font-size: 0.9em;
				margin: 0.5em 0;
			}

			.post-item .meta {
				font-size: 0.8em;
				color: rgba(0, 255, 65, 0.5);
			}

			.post-item .meta .tag {
				display: inline-block;
				padding: 1px 6px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				border-radius: 3px;
				margin-right: 8px;
			}

			.empty-state {
				text-align: center;
				padding: 3em;
				color: var(--green-dim);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<pre class="ascii-art">{asciiHeader}</pre>
			</div>

			<section>
				<span class="prompt">ls -la ./posts/</span>
				<ul class="posts-list">
					{posts.length === 0 ? (
						<li class="empty-state">
							<span class="prompt">cat: ./posts/*</span>
							<p>No posts found. Directory is empty.</p>
						</li>
					) : (
						posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<h3 class="title">{post.data.title}</h3>
									<p class="excerpt">{post.data.description}</p>
									<div class="meta">
										<span class="tag"><FormattedDate date={post.data.pubDate} /></span>
										<span>~/blog/{post.id}</span>
									</div>
								</a>
							</li>
						))
					)}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
