---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 100%;
				max-width: 900px;
				margin: auto;
				padding: 0 1.5em;
			}

			/* Navigation */
			.top-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.5em 0;
				border-bottom: 1px solid rgba(0, 255, 65, 0.2);
				margin-bottom: 2em;
			}

			.site-name {
				margin: 0;
				line-height: 1.2;
			}

			.top-nav {
				display: flex;
				gap: 0.5em;
			}

			.top-nav a {
				padding: 6px 14px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				text-decoration: none;
				color: var(--green-dim);
				font-size: 0.9em;
				transition: all 0.2s;
			}

			.top-nav a:hover,
			.top-nav a.active {
				color: var(--green);
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
			}

			.section {
				padding: 3em 0;
				border-top: 1px solid rgba(0, 255, 65, 0.1);
			}

			.section:first-child {
				border-top: none;
			}

			.section-header {
				margin-bottom: 2em;
			}

			.section-label {
				font-size: 0.8em;
				color: var(--green-dim);
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 0.5em;
			}

			.section-title {
				font-size: 1.6em;
				color: var(--green);
				text-shadow: 0 0 8px var(--green-glow);
				margin: 0;
			}

			.posts-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.post-item {
				border: 1px solid rgba(0, 255, 65, 0.15);
				border-radius: 4px;
				margin-bottom: 1.2em;
				padding: 1.5em 1.8em;
				transition: all 0.2s;
				background: rgba(0, 255, 65, 0.02);
			}

			.post-item:hover {
				border-color: var(--green);
				background: rgba(0, 255, 65, 0.05);
				box-shadow: 0 0 15px rgba(0, 255, 65, 0.15);
				transform: translateY(-2px);
			}

			.post-item a {
				text-decoration: none;
				display: block;
			}

			.post-item .title {
				font-size: 1.2em;
				margin: 0 0 0.4em 0;
				color: var(--green);
				text-shadow: 0 0 6px var(--green-glow);
			}

			.post-item .excerpt {
				color: var(--green-dim);
				font-size: 0.9em;
				margin: 0.5em 0;
				line-height: 1.7;
			}

			.post-item .meta {
				font-size: 0.8em;
				color: rgba(0, 255, 65, 0.5);
				display: flex;
				align-items: center;
				gap: 1em;
			}

			.post-item .meta .tag {
				display: inline-block;
				padding: 2px 8px;
				border: 1px solid rgba(0, 255, 65, 0.2);
				border-radius: 3px;
				font-size: 0.9em;
			}

			.post-item .meta .path {
				font-style: italic;
			}

			.empty-state {
				text-align: center;
				padding: 3em;
				color: var(--green-dim);
			}

			@media (max-width: 700px) {
				.post-item {
					padding: 1.2em;
				}
			}
		</style>
	</head>
	<body>
		<canvas id="matrix-canvas" style="position:fixed;top:0;left:0;width:100%;height:50vh;z-index:0;opacity:0.15;pointer-events:none;"></canvas>

		<!-- Navigation -->
		<nav class="top-bar">
			<pre class="site-name ascii-art"> _   _  _  ___  _   _ ___ _   _ ___ _   _  _   _ ___ _   _
| \ | || \| _ \|\  / /|_ _| \| ||_ _| \| || \ | ||_ _| \| |
|   ||    |  _/ \ V /  | ||    || ||    ||   ||  _/|    |
|_|\_||_|\_|___|  \_/  |___||_|\_||_|\__||_|\_|___||_|\_|</pre>
			<div class="top-nav">
				<a href="/">Homepage</a>
				<a href="/blog" class="active">Blog</a>
				<a href="/novel">Novel</a>
				<a href="/about">About</a>
			</div>
		</nav>

		<main>
			<!-- Section: Notes -->
			<section class="section">
				<div class="section-header">
					<div class="section-label">// SECTION 01</div>
					<h2 class="section-title">Notes & Writings / 笔记与文章</h2>
				</div>

				<ul class="posts-list">
					{posts.length === 0 ? (
						<li class="empty-state">
							<span class="prompt">cat: ./posts/*</span>
							<p>No posts found. Directory is empty.</p>
						</li>
					) : (
						posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`}>
									<h3 class="title">{post.data.title}</h3>
									<p class="excerpt">{post.data.description}</p>
									<div class="meta">
										<span class="tag"><FormattedDate date={post.data.pubDate} /></span>
										<span class="path">~/blog/{post.id}</span>
									</div>
								</a>
							</li>
						))
					)}
				</ul>
			</section>
		</main>

		<Footer />

		<script>
			// Matrix digital rain effect
			const canvas = document.getElementById('matrix-canvas');
			const ctx = canvas.getContext('2d');

			let width = canvas.width = window.innerWidth;
			let height = canvas.height = Math.floor(window.innerHeight * 0.5);

			const chars = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEF';
			const charArray = chars.split('');
			const fontSize = 14;
			const columns = Math.floor(width / fontSize);
			const drops = Array(columns).fill(1);

			window.addEventListener('resize', () => {
				width = canvas.width = window.innerWidth;
				height = canvas.height = Math.floor(window.innerHeight * 0.5);
			});

			function draw() {
				ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
				ctx.fillRect(0, 0, width, height);

				ctx.fillStyle = '#0f0';
				ctx.font = fontSize + 'px monospace';

				for (let i = 0; i < drops.length; i++) {
					const text = charArray[Math.floor(Math.random() * charArray.length)];
					ctx.fillText(text, i * fontSize, drops[i] * fontSize);

					if (drops[i] * fontSize > height && Math.random() > 0.975) {
						drops[i] = 0;
					}
					drops[i]++;
				}
			}

			setInterval(draw, 33);
		</script>
	</body>
</html>
